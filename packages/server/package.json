{
  "name": "@mmo/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.local run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "admin": "bun --env-file=../../.env --env-file=../../.env.local run src/index.ts admin",
    "admin:promote": "bun --env-file=../../.env --env-file=../../.env.local run src/index.ts admin promote",
    "start": "bun run ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@mmo/shared": "workspace:*",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
