{
  "name": "mmo-game",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter @mmo/server --filter @mmo/client dev",
    "dev:client": "bun run --filter @mmo/client dev",
    "dev:server": "bun run --filter @mmo/server dev",
    "admin:promote": "bun run --filter @mmo/server admin:promote",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "bun run --filter @mmo/server test && bun run --filter @mmo/client test",
    "ci": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
